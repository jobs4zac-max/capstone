# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# LLM — Vocareum proxy by default (course-provided, OpenAI-compatible)
# Find your key in Vocareum: left sidebar -> GenAI Details -> Credentials
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://openai.vocareum.com/v1
OPENAI_API_KEY=sk-REPLACE_ME
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# To switch to a personal OpenAI key, change only these two lines:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-your-personal-key

# ---------------------------------------------------------------------------
# Embeddings — local by default: free, offline, no allowance burn
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Knowledge base / FAISS
# Rebuild with: scripts/ingest_documents.py then scripts/build_faiss_index.py
# ---------------------------------------------------------------------------
KNOWLEDGE_RAW_DIR=./knowledge/raw
CHUNKS_PATH=./knowledge/processed/chunks.json
FAISS_INDEX_DIR=./knowledge/faiss_index

# ---------------------------------------------------------------------------
# Retrieval / thresholds  (tune on the labelled query set, not by feel)
# RETRIEVAL_FETCH_K oversamples before metadata filtering, since FAISS filters
# after retrieval rather than natively.
# ---------------------------------------------------------------------------
RETRIEVAL_K=8
RETRIEVAL_FETCH_K=24
RETRIEVAL_MIN_SCORE=0.35
MIN_CITATIONS=2
MAX_SUBQUESTIONS=3
EVENT_CONFIDENCE_THRESHOLD=0.70
HIGH_VALUE_THRESHOLD_EUR=10000

# ---------------------------------------------------------------------------
# Data stores
# NOTE: policy.json holds ADAPTIVE parameters only. Refusal boundaries live in
# safety/policy_zones.yaml and are changed by a reviewed commit, never at runtime.
# ---------------------------------------------------------------------------
POLICY_PATH=./data/policy/policy.json
FEEDBACK_STORE_PATH=./data/rlhf/feedback_store.json
TEST_CASES_PATH=./data/evaluation/test_cases.json
LOGS_DIR=./logs

# ---------------------------------------------------------------------------
# A2A / MCP
# A2A_TRANSPORT=inproc collapses the Policy Agent into this process.
# That is the documented descoping lever (PROJECT_PLAN.md section 20.5).
# ---------------------------------------------------------------------------
A2A_TRANSPORT=http
POLICY_AGENT_URL=http://localhost:8001
A2A_DEADLINE_MS=15000
MCP_SERVER_COMMAND=python -m mcp_tools.server

# ---------------------------------------------------------------------------
# Observability — off by default so a fresh clone runs with no accounts
# Langfuse is primary (captures A2A, MCP and guardrail spans too);
# LangSmith is secondary, for the LangGraph internals.
# ---------------------------------------------------------------------------
OBSERVABILITY_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=life-event-financial-navigator

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Feature flags
# llm_cache_mode: off | read | write | readwrite
#   readwrite = normal dev;  read = free deterministic replay for CI
# ---------------------------------------------------------------------------
ENABLE_RERANKING=false
ENABLE_ADAPTATION=true
ENABLE_LLM_RISK_ADVISOR=true
LLM_CACHE_MODE=readwrite
