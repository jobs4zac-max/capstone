# =============================================================================
# Deliberately COMMITTED (do not add these here):
#   uv.lock            - exact dependency pins; the whole point of reproducibility
#   requirements.txt   - pip fallback, exported from uv.lock
#   .python-version    - tells uv which interpreter to fetch
#   .env.example       - template with no real values
#   knowledge/raw/**   - the RAG source corpus, including PDFs (see negation below)
#   data/policy/policy.json, data/rlhf/feedback_store.json - seed state
#   **/.gitkeep        - preserves empty directory structure
# =============================================================================

# --- secrets: never commit ---
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
credentials.json
service-account*.json

# --- course reference documents: kept locally, not in the repo ---
# To commit an intentional deliverable anyway:  git add -f path/to/file.pdf
*.pdf
*.docx
*.doc
*.pptx
*.xlsx
*.zip
*.structure

# ...BUT the RAG source corpus must be committed, or nobody can rebuild the
# index. Negations must come after the broad pattern above.
!knowledge/raw/**/*.pdf
!knowledge/raw/**/*.docx

# --- generated retrieval artefacts -----------------------------------------
# Rebuild with: scripts/ingest_documents.py then scripts/build_faiss_index.py
# NOTE: before submission, consider `git add -f knowledge/faiss_index/*` so a
# grader can run the demo without downloading the embedding model first.
knowledge/processed/chunks.json
knowledge/faiss_index/*.faiss
knowledge/faiss_index/*.pkl

# --- runtime state ---
data/cache/
logs/*.log
*.db
*.sqlite
*.sqlite3

# --- python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/

# --- virtualenvs / installed libraries -------------------------------------
# Dependencies are NEVER committed. Another machine reproduces them with
# `uv sync` (from uv.lock) or `pip install -r requirements.txt`.
.venv/
.venv*/
venv/
env/
ENV/
site-packages/
node_modules/

# --- tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- models downloaded at runtime ---
.cache/
models/

# --- editors / os ---
.DS_Store
.idea/
.vscode/
*.swp

# --- streamlit local secrets (we use .env instead) ---
.streamlit/secrets.toml
